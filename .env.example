# Copie para ".env" e preencha. O .env NUNCA vai para o GitHub (está no .gitignore).

# ---------- Para onde enviar as planilhas: github, vercel ou github,vercel
DESTINO_WMS=github
DESTINO_SINGRA=vercel

# ---------- GitHub (repositório PRIVADO das planilhas)
# Token "fine-grained" com acesso SÓ ao repositório de armazenamento, permissão Contents: Read and write
GITHUB_STORAGE_TOKEN=
GITHUB_STORAGE_REPO=devvsa123/depfmrj-RPA-storage
GITHUB_STORAGE_BRANCH=main

# ---------- Vercel Blob
VERCEL_BLOB_TOKEN=

# ---------- Proxy de saída para a internet
HTTP_PROXY=
HTTPS_PROXY=
# 1 = valida o certificado HTTPS (deixe 0 se o proxy da rede intercepta o HTTPS)
VERIFICAR_SSL=0

# ---------- Horário de funcionamento (opcional; vazio = 24 h)
HORARIO_EXPEDIENTE=07:00-18:00
SO_DIAS_UTEIS=1

# ---------- Log em pasta de rede (opcional)
PASTA_LOGS_REDE=

# ---------- WMS
WMS_LOGIN_URL=
WMS_RELATORIO_URL=
WMS_ESTOQUE_DETALHADO=
WMS_USUARIO=
WMS_SENHA=
# 1 = mostra o Edge na tela enquanto o robô trabalha (bom para testar)
WMS_MOSTRAR_NAVEGADOR=0
# segundos de espera para cada tela do WMS carregar
WMS_ESPERA_TELA=120

# ---------- Singra
SINGRA_NIP=
SINGRA_SENHA=
SINGRA_CAM=
# Endereços dos servidores, separados por vírgula, na ordem de tentativa
SINGRA_SERVIDORES=
PROXY_HTTP=
PROXY_HTTPS=

# ---------- API Django
API_BASE_URL=
API_USER=
API_PASSWORD=
